name: Selenium TestNG & BDD CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:
    inputs:
      suite:
        description: 'Suite to run (ignored if Single Test Class is provided)'
        type: choice
        default: 'testng-serial'
        options:
          - testng-serial
          - testng-parallel
          - bdd-serial
          - bdd-parallel
      test_class:
        description: 'Optional: Run any single class independently (e.g., tests.LoginTest or runners.TestRunner)'
        type: string
        required: false
        default: ''
      browser:
        description: 'Browser (matches DriverFactory)'
        type: choice
        default: 'chrome'
        options:
          - chrome
          - edge
          - firefox
      headless:
        description: 'Run in headless mode'
        type: boolean
        default: true
      incognito:
        description: 'Run in incognito/private mode'
        type: boolean
        default: true
      block_images:
        description: 'Block images for faster loads (-DBLOCK_IMAGES)'
        type: boolean
        default: false

jobs:
  run-tests:
    runs-on: windows-latest

    defaults:
      run:
        shell: powershell

    env:
      API_BASE_URL: ${{ vars.API_BASE_URL }}
      BASE_URL: ${{ vars.BASE_URL }}
      DB_URL: ${{ vars.DB_URL }}
      DB_USERNAME: ${{ vars.DB_USERNAME }}
      DB_PASSWORD: ${{ vars.DB_PASSWORD }}
      LOGIN_USERNAME: ${{ vars.LOGIN_USERNAME }}
      LOGIN_PASSWORD: ${{ vars.LOGIN_PASSWORD }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java & cache Maven dependencies
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
          cache: 'maven'

      - name: Run Maven Tests
        env:
          SUITE: ${{ inputs.suite }}
          TEST_CLASS: ${{ inputs.test_class }}
          BROWSER: ${{ inputs.browser }}
          HEADLESS: ${{ inputs.headless }}
          INCOGNITO: ${{ inputs.incognito }}
          BLOCK_IMAGES: ${{ inputs.block_images }}
        run: |
          $suite       = if ([string]::IsNullOrWhiteSpace($env:SUITE))        { "testng-serial" } else { $env:SUITE.Trim() }
          $browser     = if ([string]::IsNullOrWhiteSpace($env:BROWSER))      { "chrome" }        else { $env:BROWSER.Trim() }
          $headless    = if ([string]::IsNullOrWhiteSpace($env:HEADLESS))     { "true" }          else { $env:HEADLESS.Trim().ToLower() }
          $incognito   = if ([string]::IsNullOrWhiteSpace($env:INCOGNITO))    { "true" }          else { $env:INCOGNITO.Trim().ToLower() }
          $blockImages = if ([string]::IsNullOrWhiteSpace($env:BLOCK_IMAGES)) { "false" }         else { $env:BLOCK_IMAGES.Trim().ToLower() }

          $mvnArgs = @(
            "test",
            "-B",
            "-Dbrowser=$browser",
            "-Dheadless=$headless",
            "-Dincognito=$incognito",
            "-DBLOCK_IMAGES=$blockImages"
          )

          if (-not [string]::IsNullOrWhiteSpace($env:TEST_CLASS)) {
            $classTarget = $env:TEST_CLASS.Trim()
            Write-Host "Running single class independently: $classTarget"
            $mvnArgs += "-Dtest=$classTarget"
            $mvnArgs += "-DfailIfNoTests=false"
          } else {
            $suiteMap = @{
              "testng-serial"   = "testng-serial.xml"
              "testng-parallel" = "testng-parallel.xml"
              "bdd-serial"      = "bdd-serial.xml"
              "bdd-parallel"    = "bdd-parallel.xml"
            }

            $suiteXml = $suiteMap[$suite]
            Write-Host "Running suite: $suiteXml"
            $mvnArgs += "-DsuiteXmlFile=$suiteXml"
          }

          Write-Host "Executing: mvn $($mvnArgs -join ' ')"
          & mvn @mvnArgs
          exit $LASTEXITCODE

      - name: Upload TestNG Reports & Evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: testng-reports-${{ github.run_number }}
          path: test-output/
          if-no-files-found: ignore
          retention-days: 14

      - name: Upload BDD Cucumber Reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: bdd-cucumber-reports-${{ github.run_number }}
          path: |
            target/cucumber-reports/cucumber.html
            target/cucumber-reports/cucumber.json
          if-no-files-found: ignore
          retention-days: 14
