<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Kill Bill BDD Parallel Suite"
       verbose="1"
       parallel="false"
       data-provider-thread-count="4">

    <listeners>
        <listener class-name="utils.artifact.ReportingListener"/>
    </listeners>

    <test name="BDD Parallel Execution">
        <classes>
            <class name="runners.ParallelTestRunner"/>
        </classes>
    </test>

</suite>
